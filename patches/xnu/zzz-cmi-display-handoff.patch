diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
index 2aac4d0..21ae3ef 100644
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -1048,6 +1048,11 @@ scale_setup(void)
 static volatile uintptr_t bp_base;
 static unsigned bp_w, bp_h, bp_rb, bp_top;
 static int      bp_bound;
+/* Set once the panel is handed to the compositor. Once set, the
+ * diagnostic renderer and the native video console must never draw
+ * into the GOP framebuffer again. */
+static int      bp_display_owned;
+static unsigned bp_user_execs;
 static unsigned bp_x, bp_y;
 
 /* Stages that fire before the framebuffer is bound (arm_vm_init, early
@@ -1117,9 +1122,11 @@ static void bp_putc(int c) {
 void boot_progress_init(void) { }
 void boot_progress_start(void) { }
 /* Bound is enough: stages before clock_service_create() must be visible too. */
+int  boot_progress_handed_off(void) { return bp_display_owned; }
 int  boot_progress_active(void) { return bp_bound; }
 
 void boot_progress_bind(uintptr_t base, unsigned w, unsigned h, unsigned rowbytes, unsigned depth) {
+    if (bp_display_owned) { bp_bound = 0; return; }  /* never take the panel back */
     if (!base || depth != 32 || !w || !h || !rowbytes) { bp_bound = 0; return; }
     if (bp_bound && base == bp_base && w == bp_w && h == bp_h && rowbytes == bp_rb) return;
     bp_base = base; bp_w = w; bp_h = h; bp_rb = rowbytes;
@@ -1141,6 +1148,21 @@ void boot_progress_bind(uintptr_t base, unsigned w, unsigned h, unsigned rowbyte
 
 void boot_progress_putc(char c) { if (bp_bound) bp_putc((unsigned char)c); }
 
+/* The legacy GOP backend asks for the framebuffer before submitting a
+ * swap. Keep this fast path as well as the self-stop above. */
+int boot_progress_prepare_scanout(void) {
+    bp_display_owned = 1;
+    bp_bound = 0;          /* bp_putc/bp_line become no-ops from here on */
+    return 1;              /* let the swap proceed */
+}
+
+void boot_progress_cancel_scanout(void) {
+    /* Do not restore bp_bound: resuming the text renderer would cover
+     * the UI again. Ownership is one-way for this boot. */
+    bp_display_owned = 1;
+    bp_bound = 0;
+}
+
 void boot_progress_stage(const char *s) {
     if (!s) return;
     bp_line(s, '*');
@@ -1148,6 +1170,16 @@ void boot_progress_stage(const char *s) {
 
 void boot_progress_process_stage(int pid, const char *name, const char *st) {
     (void)pid; (void)name;
+    /* Compositor-independent self-stop. prepare_scanout() is only called
+     * by backboardd once the UI is already presenting, so waiting for it
+     * deadlocks: the renderer covers the panel and the compositor never
+     * gets a chance. Userland exec churn is proof the kernel finished
+     * booting, so hand the framebuffer over after a handful of events. */
+    if (!bp_display_owned && pid > 1 && ++bp_user_execs >= 8) {
+        bp_display_owned = 1;
+        bp_bound = 0;
+        return;
+    }
     if (!st) return;
     bp_line(st, '>');
 }
