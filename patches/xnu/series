# cmi 板级 XNU 补丁序列，每行一个相对本目录的路径，按行序应用。
#
# 这里只放「OS profile 的 series 里、cmi 又确实需要」的那部分：
# os:patches/xnu/series 的第一项 zzz-boot-progress.patch 依赖 sheng 的
# XNU_SHENG_PMGR 代码块（sheng 在自己的 soc 补丁里加），cmi 没有那套补丁，
# 所以不引用整个 os 系列，只逐项引用它剩下的两个 XnuPrelink 补丁。
# prefix 写法与 profiles/os/*/patches/xnu/series 一致。
component:XnuPrelink/patches/xnu-10063.141.1-security-init.patch
component:XnuPrelink/patches/xnu-10063.141.1-sparse-index.patch

# Development-only: ignore APFS root-auth failure when root-unverified=1.
# Must come last: its context is produced by the arch series owner-audit patch.
cmi-root-unverified.patch

# attempt-9/launchd: enable the native trust-cache runtime (XNU_NATIVE_TRUST_CACHE)
# so an offline/unverified root can satisfy AMFI/code-signing for launchd. Safe on
# its own: it only initializes the runtime, which is the prerequisite for any
# offline trust cache to be consulted during exec.
native-trust-cache-runtime.patch
# attempt-9/launchd: skip the AMFI "Launch Constraint Violation" gate for owner/
# cryptex binaries when boot arg sheng-no-lc=1. Dev escape hatch; it does NOT relax
# the code-signature check itself, but clears the constraint-category mismatch
# that kills launchd on an offline root.
zzyc-owner-skip-launch-constraints.patch
