# cmi 内核配置
#
# 语法：CONFIG_XNU_<NAME> 在内核构建中变成 XNU_<NAME>；{tree} 会替换为构建树路径。
# 层序（见 docs/zh/reference/configuration.md）：arch 片段 → soc 片段 → os 片段 →
# 本 defconfig 最后应用，同名设置以这里为准。
#
# 本文件只写有出处或已在同 SoC 家族验证过的开关；未列的项取片段默认值。

# 源码内核闭包（模板值）
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y

# 格式 2 用 OS 配置里的预链接输入，不用源码重建 crypto
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"

# ARM 架构定时器：SM8250 用 arch timer 提供 per-CPU 计时
CONFIG_XNU_NATIVE_ARCH_TIMER=y

# SM8250 实现 PAN，copyin/copyout 必须在异常入口处理
CONFIG_XNU_NATIVE_PAN=y

# BCM2837 构建目标要求该开关；未设为 n 会回退到它固定的 panic 物理地址
CONFIG_XNU_DT_PANIC_REGION=y

# 存储：启用 UFS / 块传输，但不启用需要 owner 签名策略包的探针。该版本编译 NativeUfs 时强制 -DNATIVE_VERIFIED_BLOCK=1，
# 链接需要 VerifiedRoot kit、根策略包、libBootProgress 与 IOStorageFamily，单开 UFS
# 会在链接阶段失败（2026-11-06 CI 实测）。等 boot-progress 与根卷栈就绪后再启用。
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=y
CONFIG_XNU_NATIVE_RAM_BLOCK=y

# GPU：SM8250 是 Adreno 650；CPU GOP 呈现路径不需要 GPU 驱动
# CONFIG_XNU_NATIVE_ADRENO is not set

# attempt-14 显示阶段：启用 legacy GOP 后端。同 SoC 的 umi / alioth 已实机验证
# CPU presentation 可进 Hello / 锁屏，无需 Metal GPU。归档由
# scripts/build-gop-legacy-display.py 生成（libNativeLegacyDisplay.late.a）。
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y
# CONFIG_XNU_NATIVE_MOBILE_DISPLAY is not set

# mockfs is the QEMU smoke-test fixture: it needs build-mockfs-fixture.py
# listed in [kernel] archives to produce libmockfs_fixture.a. The OS profile
# (profiles/os/ipados-17.7.11-21H461/configs/ipados.config) enables
# CONFIG_XNU_SOURCE_MOCKFS=y, so vfs_conf.c references mockfs while nothing
# provides it and the XNU link fails on _mockfs_mountroot/_mockfs_vfsops/
# _mockfs_vnodeop_opv_desc. The defconfig is the last layer applied, so turn
# it off here. Measured on CI, 2026-11-06.
CONFIG_XNU_SOURCE_MOCKFS=n

# attempt-5: two link-time helpers. The UFS driver no longer uses
# NATIVE_VERIFIED_BLOCK, so CmiRootStub only supplies the PMGR/ boot
# progress no-ops; CmiUnverifiedRoot supplies the XNU root lookup.
# Without NATIVE_VERIFIED_BLOCK no object references vr_*/PMGR symbols, so a
# plain static archive would be dropped by the linker. Force-load both.
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/cmi-root-stub/libCmiRootStub.a -Wl,-force_load,{tree}/build/cmi-unverified-root/libCmiUnverifiedRoot.a"


# attempt-6: mount the SystemOS cryptex so dyld can open the shared cache.
# Verbatim combination from milacy/UniXNU-marble configs/marble-root_defconfig;
# its device record says the first tail-root boot stopped at
# "Library not loaded: /usr/lib/libSystem.B.dylib (no dyld cache)" because
# OWNER_CACHE_MOUNT and OWNER_UNION_SYSTEMOS were off. The two block hooks
# (native_verified_block_root_authorized / volume_device) are supplied by
# CmiUnverifiedRoot.cpp, already force-loaded into this kernel.
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_UNVERIFIED=1
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_BOOT_MANIFEST=n
CONFIG_XNU_OWNER_CACHE_VOLUME_UUID="8846FE78-2910-4297-AF97-D59BB6F8FC16"
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y
CONFIG_XNU_OWNER_DATA_MOUNT=y

# attempt-8: writable scratch Data volume at /private/var. tzinit exits 30
# on a read-only var (raphael-guowenye device record). The UUID is the
# OwnerData APFS volume inside the pinned DBRDISK1 Data seed (parsed from APSB).
CONFIG_XNU_OWNER_DATA_UNVERIFIED=1
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="1191290C-A628-4767-B286-9AB1EB43134F"

# attempt-9/bootdiag-v2 诊断：屏显进度包现在**不注入任何 CFLAGS**。
# 闸门宏 XNU_CMI_BOOTDIAG 由 osfmk/kern/boot_progress.h 自带定义，实现被
# 内联进已注册的 osfmk/kern/startup.c，osfmk/conf/files 保持原样。
# 原因：旧方案用 CONFIG_XNU_EXTRA_CFLAGS 改了 CFLAGS，触发
# Makefile.template 的 ".CFLAGS: ALWAYS" 规则重编全部 529 个 C 源文件；
# CI 的 bootstrap 遍随后在 LDFILELIST osfmk 处 Error 2，且 link.filelist
# 没写出，导致 archive-03 报 "No XNU symbol names"。另外在 conf/files
# 注册新源文件会改变 $(OBJS)，而 filelist 规则依赖全部 OBJS。
# 本版两项都不做，构建输入与已成功的 attempt-8 完全一致。
